# Copy to .env (chmod 600). Never commit .env.

# Compose project/container name and the localhost port Caddy proxies to.
APP_INSTANCE=homeapp
APP_PORT=8098

# Website recipe import (Anthropic API). Empty = import shows "not set up".
ANTHROPIC_API_KEY=
ROSIE_MODEL=claude-opus-5-5
# Recipe chat sends the whole collection each conversation; Sonnet is half the price.
ROSIE_CHAT_MODEL=claude-sonnet-5-5
# Monthly AI spending cap in USD; imports stop when it is reached.
ROSIE_MONTHLY_CAP_USD=20

# Send to kitchen (optional): an ntfy topic and the shared secret your kitchen
# display's relay checks. Empty = Send to kitchen shows "not set up".
RECIPE_TOPIC=
RECIPE_SECRET=
NTFY_SERVER=https://ntfy.sh

# Internet status
PROMETHEUS_URL=http://host.docker.internal:9090
GRAFANA_URL=http://localhost:3001

# Home (Home Assistant). A long-lived token made for this app only
# (HA: your profile > Security > Long-lived access tokens). Empty = Home shows
# "not set up". What the app may control is listed in home.toml.
HA_URL=http://host.docker.internal:8123
HA_TOKEN=

# Your own domains whose DNS points at home addresses (comma-separated).
# Recipe import refuses links to them, on top of the private-address checks.
ROSIE_PRIVATE_DOMAINS=

# Set to 0 only for plain-http local testing.
ROSIE_COOKIE_SECURE=1

# Developer section (admin only): Forgejo token with the issue scope only.
FORGEJO_TOKEN=
# Comma-separated owner/repo list the section may read.
FORGEJO_REPOS=
# 1 = allow creating issues and comments (each one is confirmed in the app).
FORGEJO_WRITE=0
# FORGEJO_URL=http://host.docker.internal:3000
# FORGEJO_WEB_URL=http://localhost:3000
